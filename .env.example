# Canonical site address, used for metadata, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional, off by default). Set to your site's domain to load Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: a self-hosted or proxied script address.
NEXT_PUBLIC_PLAUSIBLE_SRC=
